                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A working farm in Tiuj Village, built to make farming profitable.",
                  "lineHeight": 1.06,
                  "fontFamily": "$font-heading",
                  "fontSize": 48,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "zfK2L",
                  "name": "Story 1",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Ecojhar Agrology is a new start-up in agricultural products and related fields. We run a composite farmhouse of about 4.16 acres in Hazaribagh district, helping every crop reach its production target and making agriculture a profitable business.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-body",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "mIoUo",
                  "name": "Story 2",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We grow with natural, chemical-free inputs. In future we will bring other agriculture activities to farmers who need them.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-body",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
