# Copy to .env.local for local development. On Vercel, add the same names under
# Project -> Settings -> Environment Variables, then redeploy.

# Free access key from https://web3forms.com (public key, safe in browser code).
# Messages from the contact form are emailed to the address linked to this key
# in the Web3Forms dashboard.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Email address shown in the Contact section of the site.
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Maps link opened when a visitor clicks the map or "Get directions".
# Use the "Share" link of your Google Maps / Business listing.
NEXT_PUBLIC_MAPS_URL=

# Text Google uses to find the pin for the map preview (business name works).
NEXT_PUBLIC_MAPS_QUERY=
